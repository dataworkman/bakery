<% content_for :title, "Sign in" %>

<div class="mx-auto max-w-md px-4 py-8 sm:px-6 lg:px-8 mt-10">
  <div class="bg-white rounded-3xl shadow-2xl overflow-hidden border border-gray-200">
    <div class="bg-gradient-to-r from-amber-500 to-orange-500 px-6 py-8 text-center shadow-inner">
      <h1 class="text-3xl font-extrabold text-white tracking-tight">Factory Login</h1>
      <p class="mt-2 text-amber-50 font-medium text-sm">Please sign in to access the dashboard.</p>
    </div>

    <div class="px-6 py-8 sm:p-10 bg-gray-50">
      <% if alert = flash[:alert] %>
        <div class="bg-red-50 border-l-4 border-red-500 p-4 mb-6 rounded-r-lg shadow-sm">
          <p class="text-sm font-bold text-red-800 whitespace-pre-wrap"><%= alert %></p>
        </div>
      <% end %>
      <% if notice = flash[:notice] %>
        <div class="bg-green-50 border-l-4 border-green-500 p-4 mb-6 rounded-r-lg shadow-sm">
          <p class="text-sm font-bold text-green-800 whitespace-pre-wrap"><%= notice %></p>
        </div>
      <% end %>

      <%= form_with url: session_url, class: "space-y-6" do |form| %>
        <div>
          <%= form.label :email_address, "Email Address", class: "block text-sm font-bold text-gray-900" %>
          <div class="mt-2">
            <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "manager@bakery.com", value: params[:email_address], class: "block w-full rounded-xl border-gray-300 py-3 px-4 shadow-sm focus:border-amber-500 focus:ring-amber-500" %>
          </div>
        </div>

        <div>
          <%= form.label :password, "Password", class: "block text-sm font-bold text-gray-900" %>
          <div class="mt-2">
            <%= form.password_field :password, required: true, autocomplete: "current-password", placeholder: "••••••••", class: "block w-full rounded-xl border-gray-300 py-3 px-4 shadow-sm focus:border-amber-500 focus:ring-amber-500" %>
          </div>
          <div class="mt-2 text-right">
            <%= link_to "Forgot password?", new_password_path, class: "text-sm text-gray-500 hover:text-amber-600 font-medium" %>
          </div>
        </div>

        <div class="pt-4">
          <%= form.submit "Sign In ✨", class: "w-full rounded-xl bg-amber-500 px-4 py-3.5 text-center text-lg font-bold text-white shadow-lg hover:bg-amber-400 transition-all cursor-pointer border-b-4 border-amber-600 active:border-b-0 active:translate-y-1" %>
        </div>
      <% end %>
    </div>
    
    <div class="px-6 py-5 bg-white border-t border-gray-100 text-center">
      <p class="text-gray-600 font-medium text-sm">Don't have an account? <%= link_to "Sign up", signup_path, class: "text-amber-600 hover:text-amber-700 font-bold" %></p>
    </div>
  </div>
</div>
