<% content_for :title, "Sign up" %>

<div class="mx-auto max-w-md px-4 py-8 sm:px-6 lg:px-8 mt-10">
  <div class="bg-white rounded-3xl shadow-2xl overflow-hidden border border-gray-200">
    <div class="bg-gradient-to-r from-blue-600 to-blue-500 px-6 py-8 text-center shadow-inner">
      <h1 class="text-3xl font-extrabold text-white tracking-tight">Create Account</h1>
      <p class="mt-2 text-blue-100 font-medium text-sm">Join the factory management system.</p>
    </div>

    <div class="px-6 py-8 sm:p-10 bg-gray-50">
      <% if @user.errors.any? %>
        <div class="bg-red-50 border-l-4 border-red-500 p-4 mb-6 rounded-r-lg shadow-sm">
          <ul class="text-sm font-medium text-red-800 list-disc list-inside space-y-1">
            <% @user.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with model: @user, url: signup_path, class: "space-y-6" do |form| %>
        <div>
          <%= form.label :email_address, "Email Address", class: "block text-sm font-bold text-gray-900" %>
          <div class="mt-2">
            <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "email", placeholder: "you@example.com", class: "block w-full rounded-xl border-gray-300 py-3 px-4 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
          </div>
        </div>

        <div>
           <%= form.label :password, "Password", class: "block text-sm font-bold text-gray-900" %>
           <div class="mt-2">
             <%= form.password_field :password, required: true, autocomplete: "new-password", placeholder: "Create a password", class: "block w-full rounded-xl border-gray-300 py-3 px-4 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
           </div>
        </div>
        
        <div>
           <%= form.label :password_confirmation, "Confirm Password", class: "block text-sm font-bold text-gray-900" %>
           <div class="mt-2">
             <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: "Confirm your password", class: "block w-full rounded-xl border-gray-300 py-3 px-4 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
           </div>
        </div>

        <div class="pt-4">
          <%= form.submit "Sign Up 🚀", class: "w-full rounded-xl bg-blue-600 px-4 py-3.5 text-center text-lg font-bold text-white shadow-lg hover:bg-blue-500 transition-all cursor-pointer border-b-4 border-blue-700 active:border-b-0 active:translate-y-1" %>
        </div>
      <% end %>
    </div>
    
    <div class="px-6 py-5 bg-white border-t border-gray-100 text-center">
      <p class="text-gray-600 font-medium text-sm">Already have an account? <%= link_to "Log in", new_session_path, class: "text-blue-600 hover:text-blue-700 font-bold" %></p>
    </div>
  </div>
</div>
