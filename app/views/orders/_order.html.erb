<div id="<%= dom_id order %>" class="flex flex-col h-full bg-white relative">
  <% if order.cake_image.attached? && (order.cake_image.image? || order.cake_image.variable?) %>
    <div class="h-56 w-full bg-gray-100 relative overflow-hidden border-b border-gray-100">
      <%= image_tag order.cake_image, class: "absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" %>
      <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
    </div>
  <% else %>
    <div class="h-20 w-full bg-gradient-to-r from-amber-200 to-orange-200 border-b border-orange-100 flex items-center justify-center">
      <span class="text-amber-600/50 font-bold uppercase tracking-widest text-xs">No Image Provided</span>
    </div>
  <% end %>

  <div class="p-6 flex-grow flex flex-col">
    <div class="flex justify-between items-start mb-4">
      <span class="inline-flex items-center rounded-md bg-amber-50 px-2 py-1 text-xs font-bold text-amber-700 ring-1 ring-inset ring-amber-600/20 shadow-sm font-mono">
        <%= order.order_number.presence || "PENDING" %>
      </span>
      <span class="text-xs text-gray-500 font-bold bg-gray-100 px-2 py-1 rounded-md">
        <%= order.pickup_date&.strftime("%b %d, %H:%M") || "TBD" %>
      </span>
    </div>

    <h3 class="text-xl font-black text-gray-900 mb-1 leading-tight"><%= order.customer_name.presence || "No Name" %></h3>
    <p class="text-sm text-gray-500 mb-5 block"><span class="font-semibold text-gray-700">Manager:</span> <%= order.manager_name %></p>

    <div class="bg-amber-50/50 rounded-xl p-4 border border-amber-100 mt-auto">
      <p class="text-xs font-black text-amber-800 uppercase tracking-wide mb-1.5 flex items-center">
        <svg class="w-3.5 h-3.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        Cake Specs
      </p>
      <p class="text-sm text-gray-800 line-clamp-4 leading-relaxed"><%= order.cake_description %></p>
    </div>
  </div>
</div>
