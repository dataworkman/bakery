<% content_for :title, "Editing Cake Order" %>

<div class="mx-auto max-w-3xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="bg-white rounded-3xl shadow-2xl overflow-hidden border border-gray-200 relative">
    <div class="absolute top-0 left-0 -ml-16 -mt-16 w-48 h-48 rounded-full bg-blue-100 opacity-50 blur-3xl pointer-events-none"></div>
    
    <div class="bg-gradient-to-br from-gray-700 to-gray-900 px-6 py-10 text-center relative shadow-inner">
      <h1 class="text-3xl font-extrabold text-white tracking-tight sm:text-5xl drop-shadow-md">
        ✏️ Editing Order
      </h1>
      <p class="mt-3 text-gray-300 font-medium text-lg max-w-xl mx-auto">
        Modifying details for order <span class="font-mono text-amber-400 select-all"><%= @order.order_number %></span>
      </p>
    </div>

    <div class="px-6 py-10 sm:p-12 relative bg-white z-10">
      <%= render "form", order: @order %>
    </div>
    
    <div class="px-6 py-5 bg-gray-50 border-t border-gray-200 flex justify-center space-x-4 z-10 relative">
      <%= link_to "Show Order", @order, class: "text-gray-600 hover:text-gray-900 font-bold transition-colors duration-200 bg-white px-4 py-2 border border-gray-300 rounded-lg shadow-sm hover:bg-gray-50" %>
      <%= link_to "Back to Dashboard", orders_path, class: "text-amber-600 hover:text-amber-700 font-bold transition-colors duration-200 bg-white px-4 py-2 border border-amber-200 rounded-lg shadow-sm hover:bg-amber-50" %>
    </div>
  </div>
</div>
