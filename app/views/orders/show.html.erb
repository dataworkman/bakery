<% content_for :title, "Order Details" %>

<div class="mx-auto max-w-3xl px-4 py-8 sm:px-6 lg:px-8">
  <% if notice.present? %>
    <div class="rounded-xl bg-green-50 p-4 mb-6 border border-green-200 shadow-sm">
      <p class="text-sm font-medium text-green-800 text-center"><%= notice %></p>
    </div>
  <% end %>

  <div class="bg-white rounded-3xl shadow-xl overflow-hidden border border-gray-200 relative mb-6">
    <div class="bg-gradient-to-r from-amber-500 to-orange-400 px-6 py-6 border-b border-amber-600 flex items-center justify-between shadow-inner">
      <h1 class="text-2xl font-black text-white flex items-center">
        <svg class="h-6 w-6 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        Order Receipt
      </h1>
      <span class="bg-white/20 text-white border border-white/40 px-3 py-1 rounded-full font-mono text-sm font-bold shadow-sm backdrop-blur-sm"><%= @order.order_number %></span>
    </div>

    <!-- We render the order partial, but the partial expects to be in a grid.
         Since it's rendering solo here, we wrap it to constrain it nicely. -->
    <div class="group mx-auto max-w-xl p-6 sm:p-10">
      <% if @order.cake_image.attached? %>
        <div class="mb-8 rounded-2xl overflow-hidden shadow-md border-4 border-white ring-1 ring-gray-200">
           <%= image_tag @order.cake_image, class: "w-full h-auto object-cover" %>
        </div>
      <% end %>

      <div class="space-y-6">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 border-b border-gray-100 pb-6">
          <div>
            <p class="text-xs font-bold text-gray-500 uppercase tracking-wider">Branch</p>
            <p class="text-lg font-bold text-gray-900 mt-1"><%= @order.store_name %></p>
          </div>
          <div>
            <p class="text-xs font-bold text-gray-500 uppercase tracking-wider">Manager</p>
            <p class="text-lg font-medium text-gray-900 mt-1"><%= @order.manager_name %></p>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 border-b border-gray-100 pb-6">
          <div>
            <p class="text-xs font-bold text-gray-500 uppercase tracking-wider">Order Date</p>
            <p class="text-base font-medium text-gray-900 mt-1"><%= @order.order_date %></p>
          </div>
          <div>
            <p class="text-xs font-bold text-amber-600 uppercase tracking-wider">Pickup Date</p>
            <p class="text-lg font-black text-amber-700 mt-1"><%= @order.pickup_date&.strftime("%b %d, %Y - %H:%M") %></p>
          </div>
        </div>

        <div class="border-b border-gray-100 pb-6">
           <p class="text-xs font-bold text-gray-500 uppercase tracking-wider">Customer Name</p>
           <p class="text-2xl font-black text-gray-900 mt-1"><%= @order.customer_name %></p>
        </div>

        <div class="bg-amber-50 rounded-2xl p-6 border border-amber-100 mt-6 shadow-inner">
           <p class="text-xs font-bold text-amber-800 uppercase tracking-wider mb-2">Cake Specifications & Message</p>
           <p class="text-gray-800 text-base leading-relaxed whitespace-pre-wrap"><%= @order.cake_description %></p>
        </div>
      </div>
    </div>
    
    <div class="bg-gray-50 px-6 py-5 border-t border-gray-200 flex flex-col sm:flex-row justify-center space-y-3 sm:space-y-0 sm:space-x-4">
      <%= link_to "Edit Features", edit_order_path(@order), class: "text-center w-full sm:w-auto bg-white text-gray-700 hover:text-gray-900 font-bold px-6 py-3 border border-gray-300 rounded-xl shadow-sm hover:bg-gray-50 transition-colors" %>
      <%= link_to "Back to Dashboard", orders_path, class: "text-center w-full sm:w-auto bg-gradient-to-r from-amber-500 to-orange-500 text-white hover:from-amber-400 hover:to-orange-400 font-bold px-6 py-3 rounded-xl shadow-md transition-all hover:-translate-y-0.5" %>
    </div>
  </div>
</div>
