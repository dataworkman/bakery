<%= form_with(model: order, class: "space-y-10") do |form| %>
  <% if order.errors.any? %>
    <div id="error_explanation" class="bg-red-50 border-l-4 border-red-600 p-5 rounded-r-xl shadow-sm">
      <div class="flex">
        <div class="ml-4">
          <h3 class="text-sm font-bold text-red-800 uppercase tracking-wide"><%= pluralize(order.errors.count, "error") %> prohibited this order from saving:</h3>
          <ul class="mt-3 text-sm text-red-700 list-disc list-inside space-y-1">
            <% order.errors.each do |error| %>
              <li><%= error.full_message %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Block 1: Branch Details -->
  <div class="bg-gray-50 p-6 sm:p-8 rounded-2xl border-2 border-gray-200 shadow-sm relative">
    <div class="absolute -top-4 left-6 bg-amber-500 text-white px-4 py-1 rounded-full font-bold shadow-md">
      1. Branch Details
    </div>
    
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 mt-4">
      <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-100">
        <%= form.label :store_name, class: "block text-sm font-bold text-gray-900" do %>
          Branch / Store Name <span class="text-red-500">*</span>
        <% end %>
        <div class="mt-2">
          <%= form.select :store_name, Order::STORES, { prompt: "Select a store..." }, required: true, class: ["block w-full rounded-md border-gray-300 py-3 px-4 bg-gray-50 text-gray-900 focus:bg-white focus:border-amber-500 focus:ring-amber-500 appearance-none", {"border-red-400 focus:border-red-500 focus:ring-red-500": order.errors[:store_name].any?}] %>
        </div>
      </div>

      <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-100">
        <%= form.label :manager_name, class: "block text-sm font-bold text-gray-900" do %>
          Manager in Charge <span class="text-red-500">*</span>
        <% end %>
        <div class="mt-2">
          <%= form.text_field :manager_name, placeholder: "Your Name", required: true, class: ["block w-full rounded-md border-gray-300 py-3 px-4 bg-gray-50 text-gray-900 focus:bg-white focus:border-amber-500 focus:ring-amber-500", {"border-red-400 focus:border-red-500 focus:ring-red-500": order.errors[:manager_name].any?}] %>
        </div>
      </div>
    </div>
  </div>

  <!-- Block 2: Order Details -->
  <div class="bg-gray-50 p-6 sm:p-8 rounded-2xl border-2 border-gray-200 shadow-sm relative">
    <div class="absolute -top-4 left-6 bg-amber-500 text-white px-4 py-1 rounded-full font-bold shadow-md">
      2. Order Timeline
    </div>
    
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 mt-4">
      <div class="sm:col-span-2 bg-white p-4 rounded-xl shadow-sm border border-gray-100 <%= 'hidden' unless order.persisted? %>">
        <%= form.label :order_number, "Order Receipt Number", class: "block text-sm font-bold text-gray-900" %>
        <div class="mt-2">
          <%= form.text_field :order_number, placeholder: "Auto-generated upon submission", readonly: true, class: ["block w-full rounded-md border-gray-300 py-3 px-4 bg-gray-200 text-gray-900 font-mono text-lg tracking-wider cursor-not-allowed", {"border-red-400 focus:border-red-500 focus:ring-red-500": order.errors[:order_number].any?}] %>
          <% unless order.persisted? %>
            <p class="text-xs text-amber-600 mt-2 font-medium">※ The order number will be automatically generated once you submit.</p>
          <% end %>
        </div>
      </div>

      <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-100">
        <%= form.label :order_date, class: "block text-sm font-bold text-gray-900" do %>
          Date Placed <span class="text-red-500">*</span>
        <% end %>
        <div class="mt-2">
          <%= form.date_field :order_date, required: true, class: ["block w-full rounded-md border-gray-300 py-3 px-4 bg-gray-50 text-gray-900 focus:bg-white focus:border-amber-500 focus:ring-amber-500", {"border-red-400 focus:border-red-500 focus:ring-red-500": order.errors[:order_date].any?}] %>
        </div>
      </div>

      <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-100">
        <%= form.label :pickup_date, class: "block text-sm font-bold text-gray-900" do %>
          Pickup Date & Time <span class="text-red-500">*</span>
        <% end %>
        <div class="mt-2">
          <%= form.datetime_field :pickup_date, required: true, class: ["block w-full rounded-md border-gray-300 py-3 px-4 bg-gray-50 text-gray-900 focus:bg-white focus:border-amber-500 focus:ring-amber-500", {"border-red-400 focus:border-red-500 focus:ring-red-500": order.errors[:pickup_date].any?}] %>
        </div>
      </div>
    </div>
  </div>

  <!-- Block 3: Cake & Customer -->
  <div class="bg-blue-50 p-6 sm:p-8 rounded-2xl border-2 border-blue-200 shadow-sm relative">
    <div class="absolute -top-4 left-6 bg-blue-600 text-white px-4 py-1 rounded-full font-bold shadow-md">
      3. Design & Customer Specifications
    </div>
    
    <div class="mt-4 space-y-6">
      <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-100">
        <%= form.label :customer_name, class: "block text-sm font-bold text-gray-900" do %>
          Customer Full Name <span class="text-red-500">*</span>
        <% end %>
        <div class="mt-2">
          <%= form.text_field :customer_name, placeholder: "e.g. John Doe", required: true, class: ["block w-full rounded-md border-gray-300 py-3 px-4 bg-gray-50 text-gray-900 focus:bg-white focus:border-amber-500 focus:ring-amber-500", {"border-red-400 focus:border-red-500 focus:ring-red-500": order.errors[:customer_name].any?}] %>
        </div>
      </div>

      <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-100">
        <%= form.label :cake_description, "Cake Specs & Custom Message", class: "block text-sm font-bold text-gray-900" %>
        <div class="mt-2">
          <%= form.textarea :cake_description, rows: 4, placeholder: "Flavor: Chocolate\nSize: 2-Tier\nMessage: Happy Birthday!\nExtras: Pink frosting roses...", class: ["block w-full rounded-md border-gray-300 py-3 px-4 bg-gray-50 text-gray-900 focus:bg-white focus:border-amber-500 focus:ring-amber-500", {"border-red-400 focus:border-red-500 focus:ring-red-500": order.errors[:cake_description].any?}] %>
        </div>
      </div>

      <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
        <%= form.label :cake_image, "Cake Picture Reference", class: "block text-base font-bold text-gray-900 mb-3" %>
        <div class="mt-2 bg-gray-50 rounded-lg border-2 border-dashed border-gray-300 px-6 py-8 hover:border-blue-400 transition-colors">
          <div class="text-center">
            <svg class="mx-auto h-12 w-12 text-blue-300" viewBox="0 0 24 24" fill="currentColor">
              <path fill-rule="evenodd" d="M1.5 6a2.25 2.25 0 012.25-2.25h16.5A2.25 2.25 0 0122.5 6v12a2.25 2.25 0 01-2.25 2.25H3.75A2.25 2.25 0 011.5 18V6zM3 16.06V18c0 .414.336.75.75.75h16.5A.75.75 0 0021 18v-1.94l-2.69-2.689a1.5 1.5 0 00-2.12 0l-.88.879.97.97a.75.75 0 11-1.06 1.06l-5.16-5.159a1.5 1.5 0 00-2.12 0L3 16.061zm10.125-7.81a1.125 1.125 0 112.25 0 1.125 1.125 0 01-2.25 0z" />
            </svg>
            <div class="mt-4 flex text-sm leading-6 justify-center">
              <%= form.file_field :cake_image, class: "relative cursor-pointer font-bold text-blue-600 hover:text-blue-500 focus-within:ring-2 focus-within:ring-blue-600 focus-within:ring-offset-2", accept: "image/*", style: "max-width: 100%;" %>
            </div>
            <p class="text-sm text-gray-500 mt-2">Upload a sketch or inspiration photo (PNG, JPG)</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="pt-6">
    <%= form.submit "Send Order to Factory ✨", class: "w-full rounded-2xl bg-amber-500 px-8 py-5 text-center text-2xl font-black text-white shadow-lg hover:bg-amber-400 transition-all cursor-pointer border-b-4 border-amber-600 active:border-b-0 active:translate-y-1" %>
  </div>
<% end %>
